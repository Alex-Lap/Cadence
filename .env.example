DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5432/cadence

# "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

MAX_HOURS_PER_DAY=4

# Auth (Clerk). Leave CLERK_ISSUER blank to run without sign-in (everyone is
# the "demo" user). Set it to your Frontend API URL from the Clerk Dashboard ->
# API keys, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
